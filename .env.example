# Copy to .env and fill in. Nothing in this file is a real secret.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (see docker-compose.yml for local dev values) ---
DATABASE_URL=postgres://scc:scc_dev_password@localhost:5432/social_command_center

# --- Redis / queues ---
REDIS_URL=redis://localhost:6379

# --- Meta (Facebook + Instagram) app credentials ---
# Create an app at https://developers.facebook.com/apps and fill these in.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:4000/auth/meta/callback
# Used to validate X-Hub-Signature-256 on incoming webhooks. Set this to the same
# value you configure in the Meta App Dashboard webhook subscription.
META_WEBHOOK_VERIFY_TOKEN=

# --- AI Gateway ---
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3

# --- Auth (Phase 2 wires this into route middleware) ---
JWT_SECRET=change_me_dev_only
